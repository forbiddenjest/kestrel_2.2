[Unit]
Description=Kestrel background jobs
After=network-online.target kestrel.service
Wants=network-online.target

[Service]
Type=simple
User=kestrel
Group=kestrel
WorkingDirectory=/opt/kestrel
EnvironmentFile=/etc/kestrel/kestrel.env
ExecStart=/opt/kestrel/.venv/bin/python -m app.worker_service
Restart=on-failure
RestartSec=5
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/kestrel
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

[Install]
WantedBy=multi-user.target
